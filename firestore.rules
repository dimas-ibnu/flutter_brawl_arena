rules_version = '2';

// Online play (lib/net/signaling.dart): rooms hold only connection-setup
// messages. Game traffic goes peer to peer over WebRTC, not through here.
service cloud.firestore {
  match /databases/{database}/documents {
    // Quick match queue (lib/net/firestore_queue.dart). The owner creates,
    // refreshes and deletes its ticket; another player may only claim a
    // waiting ticket (waiting -> matched, with a room code).
    match /queue/{ticket} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.state == 'waiting';
      allow update: if request.auth != null && (
        (resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner)
        || (resource.data.state == 'waiting'
          && request.resource.data.state == 'matched'
          && request.resource.data.room is string
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['state', 'room'])));
      allow delete: if request.auth != null
        && resource.data.owner == request.auth.uid;
    }

    match /rooms/{code} {
      allow read: if request.auth != null;
      // The host opens a room.
      allow create: if request.auth != null
        && request.resource.data.state == 'open';
      // One guest can join: open -> full, nothing else.
      allow update: if request.auth != null
        && resource.data.state == 'open'
        && request.resource.data.state == 'full'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['state']);
      allow delete: if request.auth != null;

      match /messages/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.from in ['host', 'guest']
          && request.resource.data.kind in ['offer', 'answer', 'candidate'];
        allow update: if false;
        // Each side removes its setup messages once connected.
        allow delete: if request.auth != null;
      }
    }
  }
}
